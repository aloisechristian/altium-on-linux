+static void d2d_device_context_flush_batch(struct d2d_device_context *context)
+{
+    struct d2d_brush solid_brush = { .type = D2D_BRUSH_TYPE_SOLID };
+    D3D11_MAPPED_SUBRESOURCE map_desc;
+    ID3D11DeviceContext *d3d_context;
+    unsigned int vtx_count, face_count;
+    struct d2d_ps_cb *ps_cb_data;
+    ID3D11Buffer *ib, *vb;
+    HRESULT hr;
+
+    if (!context->batch_face_count || !context->batch_vtx_count)
+        return;
+
+    vtx_count = context->batch_vtx_count;
+    face_count = context->batch_face_count;
+    context->batch_vtx_count = 0;
+    context->batch_face_count = 0;
+
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+
+    if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)context->vs_cb,
+            0, D3D11_MAP_WRITE_DISCARD, 0, &map_desc)))
+    {
+        WARN("Failed to map vs constant buffer, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(d3d_context);
+        return;
+    }
+    memcpy(map_desc.pData, &context->batch_vs_cb, sizeof(context->batch_vs_cb));
+    ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->vs_cb, 0);
+
+    if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)context->ps_cb,
+            0, D3D11_MAP_WRITE_DISCARD, 0, &map_desc)))
+    {
+        WARN("Failed to map ps constant buffer, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(d3d_context);
+        return;
+    }
+    ps_cb_data = map_desc.pData;
+    ps_cb_data->outline = (context->batch_shape_type == D2D_SHAPE_TYPE_OUTLINE);
+    ps_cb_data->is_arc = FALSE;
+    ps_cb_data->pad[0] = 0;
+    ps_cb_data->pad[1] = 0;
+    ps_cb_data->colour_brush.type = D2D_BRUSH_TYPE_SOLID;
+    ps_cb_data->colour_brush.opacity = context->batch_opacity;
+    ps_cb_data->colour_brush.pad[0] = 0;
+    ps_cb_data->colour_brush.pad[1] = 0;
+    ps_cb_data->colour_brush.u.solid.colour = context->batch_color;
+    ps_cb_data->opacity_brush.type = D2D_BRUSH_TYPE_COUNT;
+    ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->ps_cb, 0);
+    ID3D11DeviceContext_Release(d3d_context);
+
+    ib = d2d_device_context_get_ib(context, context->batch_faces,
+            face_count * sizeof(*context->batch_faces));
+    vb = d2d_device_context_get_vb(context, context->batch_vtx,
+            vtx_count * context->batch_vtx_stride);
+
+    if (ib && vb)
+        d2d_device_context_draw(context, context->batch_shape_type, ib, 3 * face_count, vb,
+                context->batch_vtx_stride, &solid_brush, NULL);
+}
