+        }
+
+        context->dynamic_ib_size = max(aligned_size * 2, max(context->dynamic_ib_size * 2, 262144));
+        context->dynamic_ib_offset = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+        buffer_desc.ByteWidth = (context->dynamic_ib_size + 63) & ~63;
+        buffer_desc.Usage = D3D11_USAGE_DYNAMIC;
+        buffer_desc.BindFlags = D3D11_BIND_INDEX_BUFFER;
+        buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        buffer_desc.MiscFlags = 0;
+        buffer_desc.StructureByteStride = 0;
+
+        if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, NULL, &context->dynamic_ib)))
+        {
+            ERR("Failed to create dynamic index buffer, hr %#lx.\n", hr);
+            context->dynamic_ib_size = 0;
+            return NULL;
+        }
+    }
+    else if (context->dynamic_ib_offset + aligned_size > context->dynamic_ib_size)
+    {
+        context->dynamic_ib_offset = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+    }
+
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+    if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)context->dynamic_ib, 0,
+            map_type, 0, &map_desc)))
+    {
+        ERR("Failed to map dynamic index buffer, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(d3d_context);
+        return NULL;
+    }
+    memcpy((BYTE *)map_desc.pData + context->dynamic_ib_offset, data, size);
+    ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->dynamic_ib, 0);
+    ID3D11DeviceContext_Release(d3d_context);
+
+    context->last_ib_offset = context->dynamic_ib_offset;
+    context->dynamic_ib_offset += aligned_size;
+
+    return context->dynamic_ib;
+}
