+static ID3D11Buffer *d2d_device_context_get_vb(struct d2d_device_context *context, const void *data, unsigned int size)
+{
+    unsigned int aligned_size = (size + 63) & ~63;
+    D3D11_MAPPED_SUBRESOURCE map_desc;
+    ID3D11DeviceContext *d3d_context;
+    D3D11_MAP map_type = D3D11_MAP_WRITE_NO_OVERWRITE;
+    HRESULT hr;
+
+    if (!data || !size)
+        return NULL;
+
+    if (!context->dynamic_vb || context->dynamic_vb_size < aligned_size)
+    {
+        D3D11_BUFFER_DESC buffer_desc;
+
+        if (context->dynamic_vb)
+        {
+            ID3D11Buffer_Release(context->dynamic_vb);
+            context->dynamic_vb = NULL;
+        }
+
+        context->dynamic_vb_size = max(aligned_size * 2, max(context->dynamic_vb_size * 2, 1048576));
+        context->dynamic_vb_offset = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+        buffer_desc.ByteWidth = (context->dynamic_vb_size + 63) & ~63;
+        buffer_desc.Usage = D3D11_USAGE_DYNAMIC;
+        buffer_desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+        buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        buffer_desc.MiscFlags = 0;
+        buffer_desc.StructureByteStride = 0;
+
+        if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, NULL, &context->dynamic_vb)))
+        {
+            ERR("Failed to create dynamic vertex buffer, hr %#lx.\n", hr);
+            context->dynamic_vb_size = 0;
+            return NULL;
+        }
+    }
+    else if (context->dynamic_vb_offset + aligned_size > context->dynamic_vb_size)
+    {
+        context->dynamic_vb_offset = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+    }
+
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+    if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)context->dynamic_vb, 0,
+            map_type, 0, &map_desc)))
+    {
+        ERR("Failed to map dynamic vertex buffer, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(d3d_context);
+        return NULL;
+    }
+    memcpy((BYTE *)map_desc.pData + context->dynamic_vb_offset, data, size);
+    ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->dynamic_vb, 0);
+    ID3D11DeviceContext_Release(d3d_context);
+
+    context->last_vb_offset = context->dynamic_vb_offset;
+    context->dynamic_vb_offset += aligned_size;
+
+    return context->dynamic_vb;
+}
