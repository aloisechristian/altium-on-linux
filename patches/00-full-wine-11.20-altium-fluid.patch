diff --git a/dlls/win32u/gdi_perf.h b/dlls/win32u/gdi_perf.h
new file mode 100644
index 0000000..f577b65
--- /dev/null
+++ b/dlls/win32u/gdi_perf.h
@@ -0,0 +1,120 @@
+#ifndef __WINE_GDI_PERF_H
+#define __WINE_GDI_PERF_H
+
+#include <time.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static inline int wine_perf_log_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char *env = getenv("WINE_PERF_LOG");
+        enabled = (env && env[0] && env[0] != '0') ? 1 : 0;
+    }
+    return enabled;
+}
+
+struct gdi_stats_t
+{
+    unsigned long polylines;
+    unsigned long polyline_pts;
+    unsigned long polygons;
+    unsigned long rects;
+    unsigned long texts;
+    unsigned long bitblts;
+    unsigned long scrolls;
+    unsigned long flushes;
+    unsigned long endpaints;
+    unsigned long mousemoves;
+    unsigned long invalidates;
+    unsigned long hook_calls;
+    unsigned long hook_fast_hits;
+    unsigned long wfp_fast_hits;
+    unsigned long hw_mouse_inputs;
+    unsigned long accum_sends;
+    unsigned long set_cursor_calls;
+    unsigned long timer_dispatches;
+    unsigned long long time_ns;
+    unsigned long long flush_ns;
+    unsigned long long paint_app_ns;
+    unsigned long long mousemove_ns;
+    unsigned long long wait_ns;
+};
+
+extern struct gdi_stats_t g_gdi_stats;
+extern unsigned long long g_paint_start_ns;
+
+static inline unsigned long long get_time_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+static inline void record_gdi_time(unsigned long long start_ns)
+{
+    static unsigned long long last_report = 0;
+    unsigned long long now = get_time_ns();
+    g_gdi_stats.time_ns += (now - start_ns);
+
+    if (now - last_report >= 1000000000ULL)
+    {
+        if (wine_perf_log_enabled() &&
+            (g_gdi_stats.polylines || g_gdi_stats.polygons || g_gdi_stats.rects ||
+             g_gdi_stats.texts || g_gdi_stats.bitblts || g_gdi_stats.scrolls || g_gdi_stats.flushes ||
+             g_gdi_stats.endpaints || g_gdi_stats.mousemoves || g_gdi_stats.invalidates))
+        {
+            FILE *f = fopen("/tmp/wine_gdi_stats.log", "a");
+            if (f)
+            {
+                fprintf(f, "[GDI_STATS pid=%d] gdi=%.1fms flush=%.1fms app_draw=%.1fms mm_proc=%.1fms wait=%.1fms | mm=%lu inv=%lu paint=%lu | hw_in=%lu accum_send=%lu set_cursor=%lu timer=%lu | hook_fast=%lu/%lu wfp_fast=%lu\n",
+                        getpid(),
+                        g_gdi_stats.time_ns / 1000000.0,
+                        g_gdi_stats.flush_ns / 1000000.0,
+                        g_gdi_stats.paint_app_ns / 1000000.0,
+                        g_gdi_stats.mousemove_ns / 1000000.0,
+                        g_gdi_stats.wait_ns / 1000000.0,
+                        g_gdi_stats.mousemoves,
+                        g_gdi_stats.invalidates,
+                        g_gdi_stats.endpaints,
+                        g_gdi_stats.hw_mouse_inputs,
+                        g_gdi_stats.accum_sends,
+                        g_gdi_stats.set_cursor_calls,
+                        g_gdi_stats.timer_dispatches,
+                        g_gdi_stats.hook_fast_hits,
+                        g_gdi_stats.hook_calls,
+                        g_gdi_stats.wfp_fast_hits);
+                fclose(f);
+            }
+        }
+        g_gdi_stats.polylines = 0;
+        g_gdi_stats.polyline_pts = 0;
+        g_gdi_stats.polygons = 0;
+        g_gdi_stats.rects = 0;
+        g_gdi_stats.texts = 0;
+        g_gdi_stats.bitblts = 0;
+        g_gdi_stats.scrolls = 0;
+        g_gdi_stats.flushes = 0;
+        g_gdi_stats.endpaints = 0;
+        g_gdi_stats.mousemoves = 0;
+        g_gdi_stats.invalidates = 0;
+        g_gdi_stats.hook_calls = 0;
+        g_gdi_stats.hook_fast_hits = 0;
+        g_gdi_stats.wfp_fast_hits = 0;
+        g_gdi_stats.hw_mouse_inputs = 0;
+        g_gdi_stats.accum_sends = 0;
+        g_gdi_stats.set_cursor_calls = 0;
+        g_gdi_stats.timer_dispatches = 0;
+        g_gdi_stats.time_ns = 0;
+        g_gdi_stats.flush_ns = 0;
+        g_gdi_stats.paint_app_ns = 0;
+        g_gdi_stats.mousemove_ns = 0;
+        g_gdi_stats.wait_ns = 0;
+        last_report = now;
+    }
+}
+
+#endif
