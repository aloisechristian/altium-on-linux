+
+static unsigned long req_stats[REQ_NB_REQUESTS];
+static unsigned long total_stat_reqs;
+
+struct stat_entry {
+    int id;
+    unsigned long count;
+};
+
+static int cmp_entries( const void *a, const void *b )
+{
+    const struct stat_entry *ea = a, *eb = b;
+    if (eb->count > ea->count) return 1;
+    if (eb->count < ea->count) return -1;
+    return 0;
+}
+
+void record_request_stat( enum request req )
+{
+    if (req < REQ_NB_REQUESTS)
+    {
+        req_stats[req]++;
+        total_stat_reqs++;
+        if (total_stat_reqs == 1 || (total_stat_reqs % 500 == 0))
+        {
+            FILE *f = fopen( "/tmp/wineserver_profile.txt", "w" );
+            if (f)
+            {
+                struct stat_entry entries[REQ_NB_REQUESTS];
+                int n = 0;
+                for (int i = 0; i < REQ_NB_REQUESTS; i++)
+                {
+                    if (req_stats[i] > 0)
+                    {
+                        entries[n].id = i;
+                        entries[n].count = req_stats[i];
+                        n++;
+                    }
+                }
+                qsort( entries, n, sizeof(struct stat_entry), cmp_entries );
+                fprintf( f, "Total wineserver requests: %lu\n", total_stat_reqs );
+                for (int i = 0; i < n && i < 35; i++)
+                {
+                    fprintf( f, "%-35s: %lu\n", req_names[entries[i].id], entries[i].count );
+                }
+                fclose( f );
+            }
+        }
+    }
+}
